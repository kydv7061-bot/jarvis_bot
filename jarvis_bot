class Memory:
    def __init__(self):
        self.data = {
            "user_name": None,
            "user_city": None,
            "conversation_count": 0,
            "learned_facts": [],
            "notes": [],
            "reminders": [],
            "personality_mode": "casual",
            "total_tasks_done": 0,
            "habits": {},
        }

    def learn(self, key, value):
        facts = self.data.setdefault("learned_facts", [])
        for f in facts:
            if f.get("key") == key:
                f["value"] = value
                return
        facts.append({"key": key, "value": value})

    def add_note(self, text):
        self.data.setdefault("notes", []).append({
            "text": text,
            "time": datetime.datetime.now().isoformat()
        })

    def rich_context(self) -> str:
        d = self.data
        lines = []
        if d.get("user_name"): lines.append(f"Name: {d['user_name']}")
        if d.get("user_city"): lines.append(f"City: {d['user_city']}")
        facts = d.get("learned_facts", [])[:5]
        if facts:
            lines.append("Known: " + "; ".join(f"{f['key']}={f['value']}" for f in facts))
        lines.append(f"Tasks done: {d.get('total_tasks_done', 0)}")
        return "\n".join(lines) if lines else "New user."


