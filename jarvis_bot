        await update.message.reply_text("❌ Unauthorized.")
        return
    if not ctx.args:
        await update.message.reply_text("Usage: `/post Your message`", parse_mode=ParseMode.MARKDOWN)
        return
    if not CHANNEL_ID:
        await update.message.reply_text("❌ CHANNEL_ID not set in Railway variables.")
        return
    text = " ".join(ctx.args)
    try:
        await ctx.bot.send_message(chat_id=CHANNEL_ID, text=text, parse_mode=ParseMode.MARKDOWN)
        await update.message.reply_text("✅ *Posted to channel!*", parse_mode=ParseMode.MARKDOWN)
    except Exception as e:
        await update.message.reply_text(f"❌ Failed: {e}")


async def cmd_autopost(update: Update, ctx: ContextTypes.DEFAULT_TYPE):
    if update.effective_user.id != OWNER_ID:
        await update.message.reply_text("❌ Unauthorized.")
        return
    if not ctx.args:
        await update.message.reply_text("Usage: `/autopost on` or `/autopost off`")
        return
    action = ctx.args[0].lower()
    if action == "on":
        async def _auto_post(context: ContextTypes.DEFAULT_TYPE):
            if CHANNEL_ID:
                scores = get_cricket_scores()
                await context.bot.send_message(
                    chat_id=CHANNEL_ID, text=scores, parse_mode=ParseMode.MARKDOWN
                )
        ctx.job_queue.run_repeating(_auto_post, interval=1800, first=10, name="autopost")
        await update.message.reply_text("✅ *Auto-posting ON* — Cricket scores every 30 mins!", parse_mode=ParseMode.MARKDOWN)
    elif action == "off":
        jobs = ctx.job_queue.get_jobs_by_name("autopost")
        for job in jobs: job.schedule_removal()
        await update.message.reply_text("🛑 *Auto-posting OFF*", parse_mode=ParseMode.MARKDOWN)


async def reminder_fire(context: ContextTypes.DEFAULT_TYPE):
    job = context.job
    await context.bot.send_message(
        chat_id=job.chat_id,
        text=f"⏰ *JARVIS Reminder*\n\n{job.data}",
        parse_mode=ParseMode.MARKDOWN,
    )


# ══════════════════════════════════════════════════════════════════
# NATURAL LANGUAGE HANDLER  (main message handler)
# ══════════════════════════════════════════════════════════════════
async def handle_message(update: Update, ctx: ContextTypes.DEFAULT_TYPE):
    text = update.message.text.strip()
    chat_id = update.effective_chat.id

    # WhatsApp: "text ayesha hello how are you"
    wa_match = re.match(r"^text (\w+)\s+(.+)$", text, re.IGNORECASE)
    if wa_match:
        contact = wa_match.group(1).lower()
        msg     = wa_match.group(2)
        phone   = WHATSAPP_CONTACTS.get(contact)
        if phone:
            url = f"https://web.whatsapp.com/send?phone={phone}&text={urllib.parse.quote(msg)}"
            await update.message.reply_text(
                f"💬 [Open WhatsApp → {contact.title()}]({url})\n_{msg}_",
                parse_mode=ParseMode.MARKDOWN,
                disable_web_page_preview=False,
            )
        else:
            contacts_list = ", ".join(WHATSAPP_CONTACTS.keys())
            await update.message.reply_text(
                f"❌ Contact *{contact}* not found.\nAvailable: {contacts_list}",
                parse_mode=ParseMode.MARKDOWN,
            )
        return

    # Reminder with job queue
    m = re.match(r"^remind(?:er)?\s+(?:me\s+)?in\s+(\d+)\s*(min(?:ute)?s?|hours?)\s+(?:to\s+)?(.+)$",
                 text, re.IGNORECASE)
    if m:
        amount = int(m.group(1))
        unit   = m.group(2)
        msg    = m.group(3)
        secs   = amount * 3600 if "hour" in unit.lower() else amount * 60
        ctx.job_queue.run_once(
            reminder_fire,
            when=secs,
            chat_id=chat_id,
            data=msg,
        )
        await update.message.reply_text(
            f"⏰ Reminder set!\n*In {amount} {unit}:* _{msg}_",
            parse_mode=ParseMode.MARKDOWN,
        )
        return

    # AI tasks — detect keywords
    t = text.lower()

    if any(kw in t for kw in ["write", "blog", "essay", "script", "report", "email"]):
        await update.message.reply_text("✍️ _Writing, Sir..._", parse_mode=ParseMode.MARKDOWN)
        reply = jarvis.brain.generate(
            f"Write a well-structured, detailed response for: {text}\nUse proper headings and formatting.",
            max_tokens=1200,
        )
        await update.message.reply_text(reply[:4000], parse_mode=ParseMode.MARKDOWN)
        return

    if t.startswith("brainstorm"):
        await update.message.reply_text("💡 _Brainstorming..._", parse_mode=ParseMode.MARKDOWN)
        reply = jarvis.brain.generate(
            f"Generate 8 creative, detailed ideas for: {text}\nFor each: Name → What → Why it matters.",
            max_tokens=900,
        )
        await update.message.reply_text(reply[:4000], parse_mode=ParseMode.MARKDOWN)
        return

    if t.startswith("explain"):
        await update.message.reply_text("🧠 _Explaining..._", parse_mode=ParseMode.MARKDOWN)
        reply = jarvis.brain.generate(
            f"Explain clearly with: simple language → analogy → key points → example.\n\n{text}",
            max_tokens=800,
        )
        await update.message.reply_text(reply[:4000], parse_mode=ParseMode.MARKDOWN)
        return

    if t.startswith("translate"):
        reply = jarvis.brain.generate(
            f"Translate this. Reply with ONLY the translation:\n\n{text}",
            max_tokens=400,
        )
        await update.message.reply_text(f"🌐 {reply[:4000]}", parse_mode=ParseMode.MARKDOWN)
        return

    if t.startswith("debate"):
        await update.message.reply_text("⚖️ _Analyzing both sides..._", parse_mode=ParseMode.MARKDOWN)
        reply = jarvis.brain.generate(
            f"Give a balanced debate breakdown:\n*FOR (pros):* 3-4 points\n*AGAINST (cons):* 3-4 points\n*VERDICT:*\n\nTopic: {text}",
            max_tokens=700,
        )
        await update.message.reply_text(reply[:4000], parse_mode=ParseMode.MARKDOWN)
        return

    if t.startswith("summarize"):
        await update.message.reply_text("📋 _Summarizing..._", parse_mode=ParseMode.MARKDOWN)
        reply = jarvis.brain.generate(
            f"Summarize with 5 key bullet points:\n\n{text}",
            max_tokens=500,
        )
        await update.message.reply_text(reply[:4000], parse_mode=ParseMode.MARKDOWN)
        return

    if t.startswith("rewrite"):
        reply = jarvis.brain.generate(
            f"Rewrite this in a better, clearer style:\n\n{text}",
            max_tokens=600,
        )
        await update.message.reply_text(reply[:4000], parse_mode=ParseMode.MARKDOWN)
        return

    # Cricket check
    if any(kw in t for kw in ["cricket", "ipl", "live score", "match score"]):
        await update.message.reply_text("🏏 _Fetching scores..._", parse_mode=ParseMode.MARKDOWN)
        await update.message.reply_text(get_cricket_scores(), parse_mode=ParseMode.MARKDOWN)
        return

    # Default: JARVIS process (Local router → AI)
    thinking_msg = await update.message.reply_text("🤖 _Processing..._", parse_mode=ParseMode.MARKDOWN)
    reply = jarvis.process(chat_id, text)
    try:
        await thinking_msg.edit_text(reply[:4000], parse_mode=ParseMode.MARKDOWN)
    except Exception:
        await thinking_msg.edit_text(reply[:4000])


