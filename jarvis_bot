# LOCAL ROUTER  — instant, no AI
# ══════════════════════════════════════════════════════════════════
class LocalRouter:
    def __init__(self, memory: Memory, habits: HabitTracker):
        self.memory  = memory
        self.habits  = habits

    def route(self, text: str) -> Tuple[bool, str]:
        t = text.lower().strip()

        # ── WEATHER ──────────────────────────────────────────────
        m = re.match(r"^(?:weather|what(?:'s|\s+is)\s+the\s+weather)(?:\s+in\s+(.+))?$", t)
        if m:
            city = m.group(1) or self.memory.data.get("user_city", "")
            return True, self._weather(city.strip() if city else "")

        # ── YOUTUBE ──────────────────────────────────────────────
        if re.match(r"^(?:play|search yt|youtube)\s+.+", t):
            m2 = re.match(r"^(?:play|search yt|youtube)\s+(.+)", t)
            if m2:
                return True, self._youtube(m2.group(1).strip())

        # ── NOTES ────────────────────────────────────────────────
        m = re.match(r"^(?:note|save note|remember)[:\s]+(.+)$", t)
        if m:
            self.memory.add_note(m.group(1).strip())
            return True, f"📝 Note saved:\n_{m.group(1).strip()}_"

        if re.match(r"^(?:list|show|my)\s+notes?$", t):
            notes = self.memory.data.get("notes", [])
            if not notes:
                return True, "📝 No notes yet. Say `note: your text`"
            lines = ["📝 *Your Notes:*"]
            for i, n in enumerate(notes[-10:], 1):
                lines.append(f"{i}. {n['text'][:80]}")
            return True, "\n".join(lines)

        # ── REMINDERS ────────────────────────────────────────────
        m = re.match(r"^remind(?:er)?\s+(?:me\s+)?in\s+(\d+)\s*(min(?:ute)?s?|hours?)\s+(?:to\s+)?(.+)$", t)
        if m:
            amount = int(m.group(1))
            unit   = m.group(2)
            msg    = m.group(3)
            secs   = amount * 3600 if "hour" in unit else amount * 60
            fire   = datetime.datetime.now() + datetime.timedelta(seconds=secs)
            self.memory.data.setdefault("reminders", []).append({
                "time": fire.strftime("%H:%M"),
                "message": msg,
                "fire_ts": fire.timestamp(),
                "done": False,
            })
            return True, f"⏰ Reminder set!\n*In {amount} {unit}:* _{msg}_"

        if re.match(r"^(?:list|show|my)\s+reminders?$", t):
            active = [r for r in self.memory.data.get("reminders", []) if not r.get("done")]
            if not active:
                return True, "📋 No active reminders."
            lines = ["⏰ *Active Reminders:*"]
            for r in active[:8]:
                lines.append(f"  • {r['time']} — {r['message']}")
            return True, "\n".join(lines)

        # ── HABITS ───────────────────────────────────────────────
        if re.match(r"^(?:list|show|my)\s+habits?$", t):
            return True, self.habits.summary()

        m = re.match(r"^(?:i\s+)?(?:completed?|done|finished)\s+(.+)$", t)
        if m:
            return True, self.habits.done(m.group(1).strip())

        # ── PASSWORD ─────────────────────────────────────────────
        m = re.match(r"^(?:generate|create|make)\s+(?:a?\s*)?(?:(\d+)\s+char(?:s)?\s+)?password$", t)
        if m:
            n = int(m.group(1)) if m.group(1) else 16
            chars = string.ascii_letters + string.digits + "!@#$%^&*-_+=?"
            pwd = "".join(secrets.choice(chars) for _ in range(n))
            return True, f"🔐 *Generated Password:*\n`{pwd}`\n_(copy and save it)_"

        # ── QUICK RESPONSES ──────────────────────────────────────
        if re.match(r"^(?:tell\s+a?\s*)?joke$", t):
            return True, random.choice([
                "😂 Why do programmers prefer dark mode?\n*Because light attracts bugs!* 🐛",
                "😂 99 bugs in the code...\nFix one, patch around...\n*127 bugs in the code.* 😭",
                "😂 Error 404: *Motivation not found.* 💀",
                "😂 My code doesn't have bugs.\n*They're undocumented features.* ✨",
            ])

        if re.match(r"^(?:motivate\s+me|give\s+motivation)$", t):
            return True, random.choice([
                "🏆 *You've survived 100% of your worst days.*\nYou're literally undefeated.",
                "💪 *Discipline is choosing between what you want NOW and what you want MOST.*",
                "🚀 *Done is better than perfect.* Ship it. Improve it. Repeat.",
                "⚡ *One focused hour today compounds into weeks of advantage over a year.*",
            ])

        if re.match(r"^(?:daily\s+)?quote$", t):
            return True, random.choice([
                "📖 _'The best time to plant a tree was 20 years ago. The second best time is now.'_",
                "📖 _'It does not matter how slowly you go as long as you do not stop.'_ — Confucius",
                "📖 _'An investment in knowledge pays the best interest.'_ — Benjamin Franklin",
                "📖 _'In the middle of every difficulty lies opportunity.'_ — Einstein",
            ])

        if re.match(r"^roast\s+me$", t):
            return True, random.choice([
                "🔥 You opened JARVIS to get things done and you're asking me to roast you.\n*That tracks.* 💀",
                "🔥 You built a Telegram bot and *still procrastinate.*\nRespect the commitment to the bit. 😂",
            ])

        # ── WEB SEARCH ───────────────────────────────────────────
        m = re.match(r"^(?:google|search(?:\s+for)?|look up)\s+(.+)$", t)
        if m:
            query = m.group(1)
            url = f"https://www.google.com/search?q={urllib.parse.quote(query)}"
            return True, f"🔍 [Search: {query}]({url})"

        return False, ""

    def _weather(self, city: str) -> str:
        if not city:
            return "🌤 Which city? Say `weather in Bhopal`"
        if WEATHER_KEY:
            try:
                r = requests.get(
                    "https://api.openweathermap.org/data/2.5/weather",
                    params={"q": city, "appid": WEATHER_KEY, "units": "metric"},
                    timeout=8,
                )
                d = r.json()
                if d.get("cod") == 200:
                    return (
                        f"🌤 *Weather: {d['name']}, {d['sys']['country']}*\n\n"
                        f"🌡 Temp: `{d['main']['temp']:.0f}°C` (feels {d['main']['feels_like']:.0f}°C)\n"
                        f"💧 Humidity: `{d['main']['humidity']}%`\n"
                        f"💨 Wind: `{d['wind']['speed']} m/s`\n"
                        f"☁️ {d['weather'][0]['description'].title()}\n\n"
                        f"_JARVIS scan complete, Sir._"
                    )
            except Exception as e:
                log.error(f"Weather error: {e}")
        url = f"https://wttr.in/{urllib.parse.quote(city)}"
        return f"🌤 [Weather for {city}]({url})"

    def _youtube(self, query: str) -> str:
        try:
            with yt_dlp.YoutubeDL({"quiet": True, "extract_flat": True}) as ydl:
                info = ydl.extract_info(f"ytsearch1:{query}", download=False)
                if info and info.get("entries"):
                    vid_id = info["entries"][0].get("id", "")
                    title  = info["entries"][0].get("title", query)
                    if vid_id:
                        url = f"https://www.youtube.com/watch?v={vid_id}"
                        return f"▶️ *{title}*\n[Watch on YouTube]({url})"
        except Exception as e:
            log.error(f"YT search error: {e}")
        url = f"https://www.youtube.com/results?search_query={urllib.parse.quote(query)}"
        return f"▶️ [Search YouTube: {query}]({url})"


