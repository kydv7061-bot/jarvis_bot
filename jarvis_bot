class Brain:
    def __init__(self, memory: Memory):
        self.memory = memory
        self.groq = Groq(api_key=GROQ_API_KEY) if GROQ_API_KEY else None
        self.histories: dict = {}  # per chat_id

    def set_mode(self, mode: str) -> str:
        mode = mode.lower().strip()
        aliases = {"professional": "pro", "zen": "calm"}
        mode = aliases.get(mode, mode)
        if mode in PERSONALITIES:
            self.memory.data["personality_mode"] = mode
            return f"🎭 *{mode.upper()} mode activated.*"
        opts = ", ".join(PERSONALITIES.keys())
        return f"❌ Available modes: {opts}"

    def ask(self, chat_id: int, user_input: str) -> str:
        if not self.groq:
            return "❌ Groq API key not set. Add GROQ_API_KEY in Railway variables."

        history = self.histories.setdefault(chat_id, deque(maxlen=12))
        mode = self.memory.data.get("personality_mode", "casual")
        system = PERSONALITIES.get(mode, PERSONALITIES["casual"])
        context = self.memory.rich_context()
        full_system = f"{system}\n\nUser context:\n{context}\n\nNEVER say 'As an AI'. Be direct and helpful."

        history.append({"role": "user", "content": user_input})
        try:
            r = self.groq.chat.completions.create(
                model="llama-3.3-70b-versatile",
                messages=[{"role": "system", "content": full_system}, *list(history)],
                temperature=0.72,
                max_tokens=900,
            )
            reply = r.choices[0].message.content
            history.append({"role": "assistant", "content": reply})

            # Extract memory facts
            self._extract_facts(user_input)
            return reply
        except Exception as e:
            log.error(f"Groq error: {e}")
            return f"⚠️ AI error: {str(e)[:100]}"

    def _extract_facts(self, text: str):
        t = text.lower()
        m = re.search(r"my name is (\w+)", t)
        if m:
            self.memory.data["user_name"] = m.group(1).title()
            self.memory.learn("name", m.group(1).title())
        m = re.search(r"i(?:'m| am) from ([a-zA-Z ]+)", t)
        if m:
            self.memory.data["user_city"] = m.group(1).strip().title()
            self.memory.learn("city", m.group(1).strip().title())

    def generate(self, prompt: str, max_tokens=800) -> str:
        if not self.groq:
            return "❌ Groq API key not set."
        try:
            r = self.groq.chat.completions.create(
                model="llama-3.3-70b-versatile",
                messages=[{"role": "user", "content": prompt}],
                max_tokens=max_tokens,
            )
            return r.choices[0].message.content
        except Exception as e:
            return f"❌ Error: {str(e)[:100]}"

    def clear(self, chat_id: int) -> str:
        self.histories[chat_id] = deque(maxlen=12)
        return "🔄 *Memory cleared.* Fresh start, Sir."


