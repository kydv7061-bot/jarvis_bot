class JarvisBot:
    def __init__(self):
        self.memory  = Memory()
        self.habits  = HabitTracker(self.memory)
        self.brain   = Brain(self.memory)
        self.router  = LocalRouter(self.memory, self.habits)
        self._reminder_tasks: dict = {}  # chat_id → list of asyncio tasks

    def process(self, chat_id: int, text: str) -> str:
        self.memory.data["conversation_count"] = self.memory.data.get("conversation_count", 0) + 1

        # Layer 1: Local router
        handled, result = self.router.route(text)
        if handled:
            self.memory.data["total_tasks_done"] = self.memory.data.get("total_tasks_done", 0) + 1
            log.info(f"[LOCAL] {text[:50]}")
            return result

        # Layer 2: AI
        log.info(f"[AI] {text[:50]}")
        self.memory.data["total_tasks_done"] = self.memory.data.get("total_tasks_done", 0) + 1
        return self.brain.ask(chat_id, text)

    def daily_briefing(self) -> str:
        now  = datetime.datetime.now()
        name = self.memory.data.get("user_name", "")
        p    = "morning" if now.hour < 12 else "afternoon" if now.hour < 17 else "evening"
        mode = self.memory.data.get("personality_mode", "casual").upper()
        active = [r for r in self.memory.data.get("reminders", []) if not r.get("done")]
        lines = [
            f"🌅 *Good {p}{', '+name if name else ''}!*",
            f"📅 {now.strftime('%A, %d %B %Y — %I:%M %p')}",
            f"🎭 Mode: {mode}",
            f"📋 {len(active)} reminder(s) pending" if active else "📋 No pending reminders",
            "",
            self.habits.summary(),
        ]
        return "\n".join(lines)

    def what_do_i_know(self) -> str:
        d = self.memory.data
        lines = ["🧠 *What JARVIS knows about you:*\n"]
        if d.get("user_name"): lines.append(f"👤 Name: *{d['user_name']}*")
        if d.get("user_city"): lines.append(f"📍 City: *{d['user_city']}*")
        for f in d.get("learned_facts", [])[:6]:
            lines.append(f"💡 {f['key']}: {f['value']}")
        lines.append(f"\n📊 Sessions: {d.get('conversation_count',0)}")
        lines.append(f"✅ Tasks done: {d.get('total_tasks_done',0)}")
        lines.append(f"🎭 Mode: {d.get('personality_mode','casual').upper()}")
        return "\n".join(lines)


