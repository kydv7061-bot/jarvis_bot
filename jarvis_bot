# CRICKET
# ══════════════════════════════════════════════════════════════════
def get_cricket_scores() -> str:
    if not CRICKET_KEY:
        return "❌ CRICKET_KEY not set in Railway variables."
    try:
        r = requests.get(
            f"https://api.cricketdata.org/api/v1/currentMatches?apikey={CRICKET_KEY}",
            timeout=10,
        )
        data = r.json()
        if data.get("status") != "success":
            return "❌ Cricket data unavailable."
        matches = data.get("data", [])
        if not matches:
            return "🏏 No live matches right now, Sir."
        msg = "🏏 *LIVE CRICKET SCORES*\n\n"
        for match in matches[:5]:
            name   = match.get("name", "Unknown")
            status = match.get("status", "")
            msg += f"📍 *{name}*\nStatus: `{status}`\n"
            for s in match.get("score", []):
                inn  = s.get("inning", "")
                runs = s.get("r", 0)
                wkts = s.get("w", 0)
                ovrs = s.get("o", 0)
                msg += f"  {inn}: `{runs}/{wkts}` ({ovrs} ov)\n"
            msg += "\n"
        return msg + "_JARVIS cricket scan complete._"
    except Exception as e:
        return f"⚠️ Cricket scan failed: {e}"


